{
  "name": "Mandman's Notes",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",
  "workspaceMount": "type=volume,source=madmans-notes-workspace,target=/workspace",
  "workspaceFolder": "/workspace/madmans_notes",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers-extra/features/uv:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "ms-python.debugpy",
        "astral-sh.ty"
      ]
    }
  },
  "remoteEnv": {
    "PROJECT_NAME": "Madman's Notes"
  },
  "onCreateCommand": "if [ ! -d /workspace/madmans_notes/.git ]; then git clone --branch main https://github.com/vgol/madmans_notes.git /workspace/madmans_notes; fi",
  "postCreateCommand": "cd /workspace/madmans_notes && uv sync"
}
