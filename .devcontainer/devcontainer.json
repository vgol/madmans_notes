{
  "name": "Mandman's Notes",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "type=volume,source=madmans-notes-workspace,target=/workspace",
  "workspaceFolder": "/workspace/madmans_notes",

  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "ms-python.debugpy",
        "astral-sh.ty",
        "tamasfe.even-better-toml",
        "ms-toolsai.datawrangler"
      ]
    }
  },
  "remoteEnv": {
    "PROJECT_NAME": "Madman's Notes",
    "UV_LINK_MODE": "copy",
    "VIRTUAL_ENV": "/workspace/madmans_notes/.venv",
    "PATH": "/workspace/madmans_notes/.venv/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/health-check.sh"
}
